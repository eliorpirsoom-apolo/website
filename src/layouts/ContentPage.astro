---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHero from "../components/PageHero.astro";
import CtaBlock from "../components/CtaBlock.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Crumb { title: string; href?: string }
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  intro?: string;
  crumbs: Crumb[];
}
const { title, description, eyebrow, intro, crumbs } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 pt-6 lg:px-8">
    <Breadcrumbs items={crumbs} />
  </div>

  <PageHero eyebrow={eyebrow} title={title} intro={intro}>
    <div slot="actions" class="mt-7 flex flex-wrap gap-3">
      <a href="/contact/" class="inline-flex items-center justify-center rounded-full bg-[color:var(--color-ink-900)] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[color:var(--color-brand-600)]">
        לקבלת הצעת מחיר
      </a>
      <a href="#tochen" class="inline-flex items-center justify-center rounded-full border border-[color:var(--color-ink-200)] bg-white px-5 py-2.5 text-sm font-semibold text-[color:var(--color-ink-800)] hover:bg-[color:var(--color-ink-50)]">
        קראו עוד
      </a>
    </div>
  </PageHero>

  <section id="tochen" class="mx-auto max-w-7xl px-4 pb-4 pt-6 lg:px-8 lg:pt-10">
    <div class="grid gap-8 lg:grid-cols-[1fr_3fr] lg:gap-12">
      <TableOfContents />
      <article data-toc-source class="prose-he max-w-none text-[16px] leading-[1.85] text-[color:var(--color-ink-700)]">
        <slot />
      </article>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 pb-4 lg:px-8">
    <CtaBlock />
  </div>
</BaseLayout>

<script>
  function slugify(text: string): string {
    return text
      .trim()
      .toLowerCase()
      .replace(/["'״׳`.,:;!?()[\]{}<>\/\\]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-{2,}/g, "-")
      .replace(/^-|-$/g, "");
  }

  function buildToc() {
    const article = document.querySelector<HTMLElement>("[data-toc-source]");
    const lists = document.querySelectorAll<HTMLOListElement>("[data-toc-list], [data-toc-list-mobile]");
    const desktopWrapper = document.querySelector<HTMLElement>("[data-toc]");
    const mobileWrapper = document.querySelector<HTMLElement>("[data-toc-mobile]");
    if (!article || lists.length === 0) return;

    const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>("h2"));
    if (headings.length < 2) {
      desktopWrapper?.classList.add("hidden");
      mobileWrapper?.classList.add("hidden");
      return;
    }

    const used = new Set<string>();
    const entries = headings.map((h, i) => {
      let id = h.id || slugify(h.textContent || "") || `section-${i + 1}`;
      let unique = id;
      let n = 2;
      while (used.has(unique)) unique = `${id}-${n++}`;
      used.add(unique);
      h.id = unique;
      return { id: unique, text: h.textContent?.trim() || "" };
    });

    lists.forEach((list) => {
      list.innerHTML = "";
      entries.forEach((entry) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${entry.id}`;
        a.textContent = entry.text;
        a.dataset.tocLink = entry.id;
        a.className =
          "block rounded-md px-2 py-1.5 text-[color:var(--color-ink-600)] hover:bg-[color:var(--color-brand-50)] hover:text-[color:var(--color-brand-700)] transition-colors";
        li.appendChild(a);
        list.appendChild(li);
      });
    });

    if ("IntersectionObserver" in window) {
      const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
      const linkById = new Map<string, HTMLAnchorElement[]>();
      links.forEach((l) => {
        const id = l.dataset.tocLink!;
        if (!linkById.has(id)) linkById.set(id, []);
        linkById.get(id)!.push(l);
      });

      const setActive = (id: string) => {
        links.forEach((l) =>
          l.classList.remove(
            "bg-[color:var(--color-brand-50)]",
            "text-[color:var(--color-brand-700)]",
            "font-semibold",
          ),
        );
        linkById.get(id)?.forEach((l) =>
          l.classList.add(
            "bg-[color:var(--color-brand-50)]",
            "text-[color:var(--color-brand-700)]",
            "font-semibold",
          ),
        );
      };

      const observer = new IntersectionObserver(
        (events) => {
          const visible = events
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible) setActive(visible.target.id);
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
      );
      headings.forEach((h) => observer.observe(h));
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", buildToc);
  } else {
    buildToc();
  }
</script>
