---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<div class={`relative ${className}`}>
  <svg
    viewBox="0 0 600 720"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="מצלמת אבטחה עם כיסוי מלא בכל זווית"
    class="h-auto w-full"
  >
    <defs>
      <pattern id="hero-grid" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#dfeaff" stroke-width="0.6" opacity="0.7"/>
      </pattern>
      <radialGradient id="hero-lens" cx="40%" cy="40%">
        <stop offset="0%" stop-color="#86afff"/>
        <stop offset="40%" stop-color="#2a5cff"/>
        <stop offset="100%" stop-color="#0b1f66"/>
      </radialGradient>
      <radialGradient id="hero-glow" cx="50%" cy="50%">
        <stop offset="0%" stop-color="#5286ff" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#5286ff" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="hero-beam-grad" cx="300" cy="320" r="240" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#5286ff" stop-opacity="0.55"/>
        <stop offset="60%" stop-color="#5286ff" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="#5286ff" stop-opacity="0"/>
      </radialGradient>
      <clipPath id="hero-lens-clip">
        <circle cx="300" cy="328" r="42"/>
      </clipPath>
    </defs>

    <rect width="600" height="720" rx="32" fill="#ffffff" stroke="#dfeaff" stroke-width="1"/>
    <rect x="1" y="1" width="598" height="718" rx="31" fill="url(#hero-grid)"/>

    <circle cx="300" cy="320" r="290" fill="url(#hero-glow)"/>

    <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" letter-spacing="0.06em">
      <text x="32" y="50" fill="#9aa1ae">CAM_01</text>
      <g transform="translate(568, 46)">
        <circle cx="-50" cy="0" r="4" fill="#f7c948">
          <animate attributeName="opacity" values="1;0.35;1" dur="2s" repeatCount="indefinite"/>
        </circle>
        <text x="-40" y="4" fill="#9aa1ae" text-anchor="start">LIVE</text>
      </g>
    </g>

    <g stroke="#2a5cff" fill="none" stroke-linecap="round">
      <circle cx="300" cy="320" r="100" opacity="0.30" stroke-width="1.5"/>
      <circle cx="300" cy="320" r="170" opacity="0.18" stroke-width="1.5"/>
      <circle cx="300" cy="320" r="240" opacity="0.10" stroke-width="1.5"/>
      <circle cx="300" cy="320" r="310" opacity="0.05" stroke-width="1.5"/>
    </g>

    <g fill="none" stroke="#2a5cff" stroke-width="1.5">
      <circle cx="300" cy="320" r="60">
        <animate attributeName="r" values="60;300" dur="3.4s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.6;0" dur="3.4s" repeatCount="indefinite"/>
      </circle>
      <circle cx="300" cy="320" r="60">
        <animate attributeName="r" values="60;300" dur="3.4s" begin="1.7s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.6;0" dur="3.4s" begin="1.7s" repeatCount="indefinite"/>
      </circle>
    </g>

    <g>
      <animateTransform
        attributeName="transform"
        type="rotate"
        from="0 300 320"
        to="360 300 320"
        dur="7s"
        repeatCount="indefinite"
      />
      <path
        d="M 300 320 L 517 218 A 240 240 0 0 1 517 422 Z"
        fill="url(#hero-beam-grad)"
      />
    </g>

    <line x1="180" y1="118" x2="420" y2="118" stroke="#0c0e15" stroke-width="3" stroke-linecap="round"/>
    <rect x="293" y="120" width="14" height="44" fill="#0c0e15"/>
    <circle cx="300" cy="118" r="5" fill="#0c0e15"/>

    <path d="M 232 234 Q 232 178, 300 178 Q 368 178, 368 234 L 368 286 Q 368 300, 354 300 L 246 300 Q 232 300, 232 286 Z" fill="#0c0e15"/>
    <rect x="232" y="284" width="136" height="16" rx="4" fill="#242833"/>

    <circle cx="300" cy="328" r="58" fill="#0c0e15"/>
    <circle cx="300" cy="328" r="50" fill="#161922"/>
    <circle cx="300" cy="328" r="42" fill="url(#hero-lens)"/>
    <circle cx="300" cy="328" r="30" fill="#0c0e15" opacity="0.35"/>
    <circle cx="300" cy="328" r="22" fill="none" stroke="#86afff" stroke-width="1.5" opacity="0.5"/>

    <g clip-path="url(#hero-lens-clip)">
      <rect x="258" y="286" width="84" height="2" fill="#86afff" opacity="0.6">
        <animate attributeName="y" values="286;370;286" dur="2.6s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.75;0.25;0.75" dur="2.6s" repeatCount="indefinite"/>
      </rect>
    </g>

    <ellipse cx="284" cy="312" rx="11" ry="7" fill="#dfeaff" opacity="0.55"/>
    <circle cx="282" cy="310" r="3" fill="#ffffff"/>

    <circle cx="354" cy="250" r="5" fill="#f7c948"/>
    <circle cx="354" cy="250" r="10" fill="#f7c948" opacity="0.25">
      <animate attributeName="r" values="9;14;9" dur="2.4s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.3;0;0.3" dur="2.4s" repeatCount="indefinite"/>
    </circle>

    <g>
      <g transform="translate(160 480)">
        <circle r="7" fill="#f7c948"/>
        <circle r="9" fill="none" stroke="#f7c948" stroke-width="1.5">
          <animate attributeName="r" values="9;26" dur="2.4s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.8;0" dur="2.4s" repeatCount="indefinite"/>
        </circle>
      </g>
      <g transform="translate(440 458)">
        <circle r="7" fill="#2a5cff"/>
        <circle r="9" fill="none" stroke="#2a5cff" stroke-width="1.5">
          <animate attributeName="r" values="9;26" dur="2.4s" begin="0.8s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.8;0" dur="2.4s" begin="0.8s" repeatCount="indefinite"/>
        </circle>
      </g>
      <g transform="translate(300 580)">
        <circle r="7" fill="#2a5cff"/>
        <circle r="9" fill="none" stroke="#2a5cff" stroke-width="1.5">
          <animate attributeName="r" values="9;26" dur="2.4s" begin="1.6s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.8;0" dur="2.4s" begin="1.6s" repeatCount="indefinite"/>
        </circle>
      </g>
    </g>

    <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" letter-spacing="0.06em" fill="#9aa1ae">
      <text x="32" y="688">270° COVERAGE</text>
      <text x="568" y="688" text-anchor="end">4K · IP67</text>
    </g>
  </svg>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    svg animate,
    svg animateTransform,
    svg animateMotion {
      display: none;
    }
  }
</style>
