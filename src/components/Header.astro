---
import Logo from "./Logo.astro";
import { nav } from "../data/nav.ts";
import { site } from "../data/site.ts";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  const clean = href.replace(/\/$/, "") || "/";
  if (clean === "/") return currentPath === "/";
  return currentPath === clean || currentPath.startsWith(clean + "/");
}
---
<header class="sticky top-0 z-40 border-b border-[color:var(--color-ink-100)] bg-white/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 lg:px-8">
    <Logo />

    <nav aria-label="ניווט ראשי" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li class="nav-group relative">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              aria-haspopup={item.children ? "true" : undefined}
              class:list={[
                "inline-flex items-center gap-1 rounded-lg px-3 py-2 text-[14px] font-medium transition-colors",
                isActive(item.href)
                  ? "text-[color:var(--color-brand-600)]"
                  : "text-[color:var(--color-ink-700)] hover:text-[color:var(--color-brand-600)]",
              ]}
            >
              <span>{item.title}</span>
              {item.children && (
                <svg aria-hidden="true" class="h-3 w-3 opacity-60" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="nav-panel absolute right-0 top-full mt-2 min-w-[280px] rounded-2xl border border-[color:var(--color-ink-100)] bg-white p-2 shadow-xl">
                <ul role="menu" class="flex flex-col">
                  {item.children.map((child) => (
                    <li role="none">
                      <a
                        role="menuitem"
                        href={child.href}
                        aria-current={isActive(child.href) ? "page" : undefined}
                        class:list={[
                          "block rounded-lg px-3 py-2 text-[13.5px] transition-colors",
                          isActive(child.href)
                            ? "bg-[color:var(--color-brand-50)] text-[color:var(--color-brand-700)] font-semibold"
                            : "text-[color:var(--color-ink-700)] hover:bg-[color:var(--color-ink-50)] hover:text-[color:var(--color-brand-600)]",
                        ]}
                      >
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href={`tel:${site.phoneIntl}`}
        class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-ink-900)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[color:var(--color-brand-600)]"
      >
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.6 10.8a15.4 15.4 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57.55 0 1 .45 1 1V20a1 1 0 0 1-1 1A18 18 0 0 1 2 4a1 1 0 0 1 1-1h3.5c.55 0 1 .45 1 1 0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1L6.6 10.8z"/>
        </svg>
        <span>{site.phone}</span>
      </a>
    </div>

    <button
      type="button"
      class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[color:var(--color-ink-100)] text-[color:var(--color-ink-700)]"
      aria-label="פתיחת תפריט"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-[color:var(--color-ink-100)] bg-white" data-menu-panel>
    <nav aria-label="ניווט ראשי במובייל" class="mx-auto max-w-7xl px-4 py-4">
      <ul class="flex flex-col gap-1">
        {nav.map((item) => (
          <li>
            {item.children ? (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-[15px] font-medium text-[color:var(--color-ink-800)] hover:bg-[color:var(--color-ink-50)]">
                  <span>{item.title}</span>
                  <svg aria-hidden="true" class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 4l4 4 4-4"/>
                  </svg>
                </summary>
                <ul class="mr-2 mt-1 flex flex-col border-r border-[color:var(--color-ink-100)] pr-3">
                  <li>
                    <a href={item.href} class="block rounded px-2 py-1.5 text-[13.5px] text-[color:var(--color-brand-600)] hover:bg-[color:var(--color-brand-50)]">
                      כל ה{item.title.replace(/^התקנת\s*/, "")} →
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block rounded px-2 py-1.5 text-[13.5px] text-[color:var(--color-ink-700)] hover:bg-[color:var(--color-ink-50)]">
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} class="block rounded-lg px-3 py-2 text-[15px] font-medium text-[color:var(--color-ink-800)] hover:bg-[color:var(--color-ink-50)]">
                {item.title}
              </a>
            )}
          </li>
        ))}
      </ul>
      <a
        href={`tel:${site.phoneIntl}`}
        class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[color:var(--color-ink-900)] px-4 py-3 text-sm font-semibold text-white"
      >
        חייגו עכשיו · {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
    });
  }
</script>
