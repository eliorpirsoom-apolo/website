---
import { site } from "../data/site.ts";

const waText = encodeURIComponent("שלום, אשמח לקבל הצעת מחיר למערכת אבטחה");
const waHref = `https://wa.me/${site.whatsapp}?text=${waText}`;
---
<div class="fixed bottom-4 left-4 z-50 flex flex-col gap-2.5 print:hidden">
  <a
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="שליחת הודעה בווטסאפ"
    class="group inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-[#25D366]/30 transition-transform hover:scale-110"
  >
    <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
      <path d="M19.05 4.9A10 10 0 0 0 4.6 18.39L3 22l3.7-1.57A10 10 0 1 0 19.05 4.9zM12 20.13a8.13 8.13 0 0 1-4.13-1.13l-.3-.18-2.2.94.94-2.14-.2-.32A8.13 8.13 0 1 1 12 20.13zm4.66-6.08c-.26-.13-1.51-.74-1.74-.83-.23-.08-.4-.13-.57.13-.17.26-.66.83-.81 1-.15.17-.3.19-.55.06-.26-.13-1.08-.4-2.06-1.27-.76-.68-1.27-1.51-1.42-1.77-.15-.26-.02-.4.11-.53.11-.11.26-.3.4-.45.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.07-.13-.57-1.37-.78-1.88-.2-.5-.41-.43-.57-.43h-.49c-.17 0-.45.06-.68.32-.23.26-.89.87-.89 2.12 0 1.26.91 2.47 1.04 2.64.13.17 1.79 2.74 4.33 3.84 1.6.69 2.22.75 3.02.63.49-.07 1.51-.62 1.72-1.21.21-.6.21-1.11.15-1.21-.06-.11-.23-.17-.49-.3z"/>
    </svg>
  </a>
  <a
    href={`tel:${site.phoneIntl}`}
    aria-label="חיוג טלפוני"
    class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-[color:var(--color-ink-900)] text-white shadow-lg shadow-black/20 transition-transform hover:scale-110"
  >
    <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M6.6 10.8a15.4 15.4 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57.55 0 1 .45 1 1V20a1 1 0 0 1-1 1A18 18 0 0 1 2 4a1 1 0 0 1 1-1h3.5c.55 0 1 .45 1 1 0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1L6.6 10.8z"/>
    </svg>
  </a>
</div>
