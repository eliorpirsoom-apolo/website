---
const slides = [
  {
    title: "מצלמות אבטחה",
    description: "התקנת מצלמות לבית ולעסק עם מערכת חכמה, צפייה מהאפליקציה והגדרות אבטחה קשוחות.",
    href: "/security-cameras/",
    bg: "linear-gradient(135deg, #1944e0 0%, #0b1f66 100%)",
    icon: "camera",
  },
  {
    title: "אינטרקום וידאו",
    description: "אינטרקום אודיו ווידאו לבית פרטי ולבניין, כולל חיבור לפתיחת שער ודלת.",
    href: "/intercom/",
    bg: "linear-gradient(135deg, #2a5cff 0%, #1336b3 100%)",
    icon: "intercom",
  },
  {
    title: "מערכות אזעקה",
    description: "אזעקות חוטיות ואלחוטיות עם חיישנים, חיווי וחיבור למוקד.",
    href: "/alarms/",
    bg: "linear-gradient(135deg, #161922 0%, #0c0e15 100%)",
    icon: "alarm",
  },
  {
    title: "התקנה ותחזוקה",
    description: "סקר אתר ראשוני, התקנה נקייה, כיוון מדויק ושירות שלא נעלם.",
    href: "/contact/",
    bg: "linear-gradient(135deg, #f7c948 0%, #d4a020 100%)",
    icon: "tools",
    invert: true,
  },
];
---
<section class="mx-auto max-w-7xl px-4 py-14 lg:px-8 lg:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <div class="text-[12px] font-mono uppercase tracking-wider text-[color:var(--color-ink-400)]">השירותים שלנו</div>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-[color:var(--color-ink-900)] sm:text-3xl lg:text-4xl">
        פתרונות מקצועיים לכל סוג של נכס
      </h2>
    </div>
    <div class="hidden gap-2 lg:flex">
      <button
        type="button"
        data-slider-prev
        aria-label="הקודם"
        class="grid h-11 w-11 place-items-center rounded-full border border-[color:var(--color-ink-200)] bg-white text-[color:var(--color-ink-700)] transition-colors hover:bg-[color:var(--color-ink-50)] disabled:opacity-30"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
      <button
        type="button"
        data-slider-next
        aria-label="הבא"
        class="grid h-11 w-11 place-items-center rounded-full border border-[color:var(--color-ink-200)] bg-white text-[color:var(--color-ink-700)] transition-colors hover:bg-[color:var(--color-ink-50)] disabled:opacity-30"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>

  <div
    data-slider-track
    class="mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {slides.map((slide) => (
      <article
        data-slide
        class:list={[
          "group relative flex min-w-[85%] snap-start flex-col justify-between overflow-hidden rounded-[28px] p-7 text-white sm:min-w-[55%] lg:min-w-[calc(33.333%-13.4px)] lg:p-8",
          slide.invert ? "text-[color:var(--color-ink-900)]" : "text-white",
        ]}
        style={`background:${slide.bg}; aspect-ratio: 4/5;`}
      >
        <div class="relative z-10 flex items-start justify-between">
          <div class={`grid h-14 w-14 place-items-center rounded-2xl ${slide.invert ? "bg-[color:var(--color-ink-900)]/10" : "bg-white/10"} backdrop-blur-sm`}>
            {slide.icon === "camera" && (
              <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="9" width="20" height="14" rx="2"/>
                <circle cx="14" cy="16" r="4"/>
                <path d="M24 13l4-2v10l-4-2"/>
              </svg>
            )}
            {slide.icon === "intercom" && (
              <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="3" width="14" height="26" rx="2"/>
                <circle cx="16" cy="10" r="2.5"/>
                <line x1="12" y1="17" x2="20" y2="17"/>
                <line x1="12" y1="21" x2="20" y2="21"/>
                <line x1="12" y1="25" x2="20" y2="25"/>
              </svg>
            )}
            {slide.icon === "alarm" && (
              <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 14a10 10 0 0 1 20 0v6l2 4H4l2-4z"/>
                <path d="M13 28a3 3 0 0 0 6 0"/>
              </svg>
            )}
            {slide.icon === "tools" && (
              <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 4l-3 3 6 6 3-3a4.24 4.24 0 0 0-6-6z"/>
                <path d="M19 7L4 22v6h6L25 13"/>
              </svg>
            )}
          </div>
          <span aria-hidden="true" class={`text-[11px] font-mono ${slide.invert ? "text-[color:var(--color-ink-900)]/60" : "text-white/60"}`}>
            {String(slides.indexOf(slide) + 1).padStart(2, "0")} / {String(slides.length).padStart(2, "0")}
          </span>
        </div>

        <div class="relative z-10">
          <h3 class="text-2xl font-bold leading-tight lg:text-[28px]">{slide.title}</h3>
          <p class={`mt-3 text-sm leading-relaxed ${slide.invert ? "text-[color:var(--color-ink-700)]" : "text-white/85"}`}>
            {slide.description}
          </p>
          <a
            href={slide.href}
            class={`mt-5 inline-flex items-center gap-1.5 text-sm font-semibold transition-transform group-hover:-translate-x-1 ${slide.invert ? "text-[color:var(--color-ink-900)]" : "text-white"}`}
          >
            <span>פרטים נוספים</span>
            <span aria-hidden="true">←</span>
          </a>
        </div>

        <div
          aria-hidden="true"
          class="pointer-events-none absolute -bottom-16 -left-16 h-56 w-56 rounded-full opacity-20"
          style="background: radial-gradient(circle, currentColor 0%, transparent 70%)"
        ></div>
      </article>
    ))}
  </div>

  <div class="mt-4 flex items-center justify-center gap-2 lg:hidden">
    {slides.map((_, i) => (
      <button
        type="button"
        data-slider-dot={i}
        aria-label={`עבור לשקופית ${i + 1}`}
        class="h-2 w-2 rounded-full bg-[color:var(--color-ink-200)] transition-all aria-[current=true]:w-6 aria-[current=true]:bg-[color:var(--color-ink-900)]"
      ></button>
    ))}
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-slider-track]");
  const slides = track ? Array.from(track.querySelectorAll<HTMLElement>("[data-slide]")) : [];
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-slider-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-slider-next]");
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-slider-dot]"));

  if (track && slides.length) {
    const slideWidth = () => slides[0].getBoundingClientRect().width + 20;

    prevBtn?.addEventListener("click", () => {
      track.scrollBy({ left: -slideWidth(), behavior: "smooth" });
    });
    nextBtn?.addEventListener("click", () => {
      track.scrollBy({ left: slideWidth(), behavior: "smooth" });
    });

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        const target = slides[i];
        if (!target) return;
        track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: "smooth" });
      });
    });

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = slides.indexOf(entry.target as HTMLElement);
              dots.forEach((d, i) => {
                if (i === idx) d.setAttribute("aria-current", "true");
                else d.removeAttribute("aria-current");
              });
            }
          });
        },
        { root: track, threshold: 0.55 },
      );
      slides.forEach((s) => observer.observe(s));
    }
  }
</script>
