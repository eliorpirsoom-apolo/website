const parent = { title: "התקנת אינטרקום לבית פרטי או לעסק", href: "/intercom/" };
---
<ContentPage
  title={title}
  description="תיקון אינטרקום מהיר לבית ולבניין — אבחון בשטח, החלפת חלקים ושירות אמין."
  eyebrow="אינטרקום"
  intro="שירות תיקון אינטרקום מקצועי — אבחון תקלה בשטח, החלפת רכיבים שבורים וחזרת המערכת לפעולה מלאה."
  crumbs={[parent, { title }]}
/>
