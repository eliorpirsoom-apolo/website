---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHero from "../components/PageHero.astro";
import CtaBlock from "../components/CtaBlock.astro";
---
<BaseLayout title="אודות" description="מי אנחנו — צוות מקצועי בתחום מערכות אבטחה, מצלמות, אינטרקום ואזעקות.">
  <div class="mx-auto max-w-7xl px-4 pt-6 lg:px-8">
    <Breadcrumbs items={[{ title: "אודות" }]} />
  </div>
  <PageHero
    eyebrow="הצוות מאחורי השירות"
    title="אודות"
    intro="אנחנו מתמחים בתכנון והתקנת מערכות אבטחה לבית ולעסק. שילוב של ניסיון בשטח, ציוד איכותי ושירות שלא נגמר ביום ההתקנה."
  />
  <article class="mx-auto max-w-3xl px-4 pb-10 text-[15.5px] leading-relaxed text-[color:var(--color-ink-700)]">
    <div class="rounded-2xl border border-dashed border-[color:var(--color-ink-200)] bg-white/60 p-6 text-sm text-[color:var(--color-ink-500)]">
      תוכן עמוד "אודות" יוזן בהמשך.
    </div>
  </article>
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <CtaBlock />
  </div>
</BaseLayout>
