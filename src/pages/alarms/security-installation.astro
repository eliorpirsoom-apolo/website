const title = "התקנת מערכות אבטחה";
const parent = { title: "התקנת מערכות אזעקה", href: "/alarms/" };
---
<ContentPage
  title={title}
  description="התקנת מערכות אבטחה משולבות — תכנון, אספקה והתקנה מקצה לקצה."
  eyebrow="אבטחה"
  intro="שירות התקנה מלא של מערכות אבטחה — מסקר אתר ראשוני ועד הדרכה והפעלה של המערכת המוכנה."
  crumbs={[parent, { title }]}
/>
