const title = "אזעקה אלחוטית לבית";
const parent = { title: "התקנת מערכות אזעקה", href: "/alarms/" };
---
<ContentPage
  title={title}
  description="אזעקה אלחוטית לבית — התקנה נקייה, ללא חיווט, חיבור ישיר לאפליקציה."
  eyebrow="אזעקות"
  intro="מערכת אזעקה אלחוטית לבית — התקנה מהירה ונקייה, ללא שבירת קירות, עם שליטה מלאה מהאפליקציה."
  crumbs={[parent, { title }]}
/>
