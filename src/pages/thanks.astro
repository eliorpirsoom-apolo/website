---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.ts";
---
<BaseLayout title="הפנייה התקבלה" description="תודה — קיבלנו את הפנייה שלכם ונחזור אליכם בהקדם." noIndex={true}>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center lg:px-8">
    <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-[color:var(--color-brand-50)] text-[color:var(--color-brand-600)]">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12.5l4.5 4.5L19 7"/>
      </svg>
    </div>
    <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[color:var(--color-ink-900)] sm:text-4xl">
      תודה! הפנייה התקבלה.
    </h1>
    <p class="mt-3 text-[color:var(--color-ink-500)]">
      אחד מאיתנו יחזור אליכם בהקדם. במקרים דחופים תמיד אפשר לחייג ישירות.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href={`tel:${site.phoneIntl}`} class="inline-flex items-center justify-center rounded-full bg-[color:var(--color-ink-900)] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[color:var(--color-brand-600)]">
        חייגו · {site.phone}
      </a>
      <a href="/" class="inline-flex items-center justify-center rounded-full border border-[color:var(--color-ink-200)] bg-white px-5 py-2.5 text-sm font-semibold text-[color:var(--color-ink-800)] hover:bg-[color:var(--color-ink-50)]">
        חזרה לעמוד הבית
      </a>
    </div>
  </section>
</BaseLayout>
